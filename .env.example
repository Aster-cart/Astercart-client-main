# Vite environment variables — copy to .env.local and fill in real values.
# NEVER commit .env.local with real secrets.

# Sentry (crash reporting). Leave unset to disable the SDK at runtime.
VITE_SENTRY_DSN=

# App environment sent to Sentry: "development" | "production" | "staging".
# Defaults to development in dev, production in prod builds.
VITE_APP_ENV=

# Optional: overrides the "admin@0.0.0" release derived from package.json.
VITE_APP_VERSION=

# --- Build-time (Vercel) — only needed to upload source maps to Sentry. ---
# These are NOT exposed to the browser; the vite plugin (vite.config.ts)
# reads them at build time and attaches a source map to release
# "admin@<VITE_APP_VERSION>". Without them, builds still succeed but stack
# traces stay minified/unresolvable.
SENTRY_AUTH_TOKEN=
SENTRY_ORG_SLUG=
SENTRY_PROJECT_SLUG=
